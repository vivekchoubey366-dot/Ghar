{
  "name": "ghar-real-estate-platform",
  "version": "1.0.0",
  "description": "GHAR -- Premium Real Estate Platform with property listings, authentication, enquiries, bookings, payments and administration.",
  "private": true,
  "main": "server.js",
  "type": "commonjs",

  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "node --check server.js"
  },

  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },

  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },

  "devDependencies": {
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },

  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js",
      "controllers/**/*.js",
      "middleware/**/*.js",
      "routes/**/*.js",
      "services/**/*.js",
      "!node_modules/**"
    ]
  },

  "keywords": [
    "real-estate",
    "property",
    "ghar",
    "express",
    "postgresql",
    "jwt",
    "api"
  ],

  "license": "UNLICENSED"
}
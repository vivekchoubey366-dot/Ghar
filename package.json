{
  "name": "ghar",
  "version": "1.0.0",
  "description": "GHAR - Premium Real Estate Platform with property management, buyer, seller, tenant, admin, AI, verification, payments and realtime services.",
  "main": "server.js",
  "type": "commonjs",

  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",

    "check": "node --check server.js",
    "check:all": "node --check server.js",

    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "validate": "npm run check && npm run lint && npm test",

    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",

    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix"
  },

  "keywords": [
    "ghar",
    "real-estate",
    "property",
    "property-management",
    "real-estate-platform",
    "buyer",
    "seller",
    "tenant",
    "admin",
    "ai",
    "property-search",
    "property-investment",
    "property-loans",
    "kyc",
    "payments",
    "subscriptions",
    "postgresql",
    "express",
    "nodejs"
  ],

  "author": "GHAR",
  "license": "UNLICENSED",
  "private": true,

  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },

  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "pg-format": "^1.0.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "validator": "^13.12.0",
    "zod": "^3.24.1"
  },

 "dependencies": {
  "bcrypt": "^5.1.1",
  "compression": "^1.7.5",
  "cookie-parser": "^1.4.7",
  "cors": "^2.8.5",
  "dotenv": "^16.4.7",
  "express": "^4.21.2",
  "express-rate-limit": "^7.5.0",
  "helmet": "^8.0.0",
  "jsonwebtoken": "^9.0.2",
  "morgan": "^1.10.0",
  "multer": "^2.0.0",
  "nodemailer": "^6.10.0",
  "pg": "^8.13.1",
  "pg-format": "^1.0.4",
  "socket.io": "^4.8.1",
  "uuid": "^11.0.5",
  "validator": "^13.12.0",
  "zod": "^3.24.1"
},

  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "server.js",
      "routes/**/*.js",
      "controllers/**/*.js",
      "services/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "config/**/*.js",
      "utils/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "clearMocks": true,
    "restoreMocks": true,
    "forceExit": false
  },

  "nodemonConfig": {
    "watch": [
      "server.js",
      "routes",
      "controllers",
      "services",
      "models",
      "middleware",
      "config",
      "utils"
    ],
    "ext": "js,json",
    "ignore": [
      "uploads/**",
      "logs/**",
      "coverage/**",
      "node_modules/**"
    ],
    "delay": "500"
  },

  "files": [
    "server.js",
    "package.json",
    "README.md",
    ".env.example",
    "routes",
    "controllers",
    "services",
    "models",
    "middleware",
    "config",
    "utils",
    "assets",
    "data"
  ]
}